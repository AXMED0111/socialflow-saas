TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
BACKEND_API_URL=http://localhost:3000/api
# A service-account style token the bot uses to call the backend on behalf of users.
# In this simple version, each Telegram user must link their account with /start,
# and the bot stores a per-user JWT after login.

# ===== ADMIN =====
# Must match the backend's ADMIN_API_KEY exactly - used for /pending, /approve, /reject.
ADMIN_API_KEY=change_this_to_a_long_random_string
# Your numeric Telegram user ID (message the bot /myid to find it). Only this
# ID can use the admin commands.
ADMIN_TELEGRAM_ID=

# ===== PAYMENT INSTRUCTIONS SHOWN TO CUSTOMERS =====
# Free-text shown when a customer picks "Local Payment" (e.g. mobile money / bank transfer details).
LOCAL_PAYMENT_INSTRUCTIONS=Send payment via [mobile money/bank] to [account details], then reply here with the transaction reference.
# Crypto wallet customers should send payment to.
CRYPTO_WALLET_ADDRESS=
CRYPTO_NETWORK=
# Free-text shown when a customer picks "International" (e.g. a Payoneer/Wise/Paddle link).
INTERNATIONAL_PAYMENT_INSTRUCTIONS=International payments aren't set up yet - contact support.

