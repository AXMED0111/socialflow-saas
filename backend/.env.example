# ===== COMPANY INFO (change per client deployment) =====
COMPANY_NAME=Cawl Pizza Demo
COMPANY_ID=comp_001

# ===== SERVER =====
PORT=3000
NODE_ENV=development

# ===== DATABASE (SQLite file path - one file per company) =====
DATABASE_PATH=./database/company_001.db

# ===== AUTH =====
JWT_SECRET=change_this_to_a_long_random_string_per_company
JWT_EXPIRY=7d

# ===== TELEGRAM BOT (unique per company) =====
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=change_this_random_string

# ===== FILE STORAGE =====
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
# If using S3 instead:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# ===== SOCIAL PLATFORM APP CREDENTIALS (per company) =====
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# ===== DASHBOARD =====
DASHBOARD_URL=http://localhost:5173

# ===== SUBSCRIPTIONS / BILLING =====
# Days of free trial a brand-new signup gets before needing to pay. 0 (default)
# means every new signup starts as pending_payment and must submit a payment
# claim before they can schedule posts.
TRIAL_DAYS=0
# Shared secret the Telegram bot's admin commands (/pending, /approve, /reject,
# /setpromo, /clearpromo) send as the x-admin-key header to /api/billing/* admin routes.
ADMIN_API_KEY=change_this_to_a_long_random_string

# ===== PRICING =====
# Base prices, before any seasonal discount. Whole numbers or decimals both work.
PRICE_MONTHLY=10
PRICE_YEARLY=100
CURRENCY=USD
# How many days one paid period covers, per cycle. 30/365 are sane defaults;
# change only if you want e.g. a 28-day "monthly" cycle.
MONTHLY_PERIOD_DAYS=30
YEARLY_PERIOD_DAYS=365
# Seasonal discounts (New Year's sale, etc.) are NOT set here - they're
# managed live from the Telegram bot with /setpromo and /clearpromo so you
# can turn a sale on or off without redeploying anything.

